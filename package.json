{
  "name": "layerfs-connect",
  "version": "0.1.0",
  "private": true,
  "description": "LayerFS Connect: the LayerFS desktop app. Projects, history and demo runs of scripted agents on the real LayerFS",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/inter": "5.3.0",
    "@layerfs/agent": "link:../layerfs/api/agent/sdk",
    "@layerfs/backend": "link:../layerfs/api/backend",
    "@layerfs/cli": "link:../layerfs/api/agent/cli",
    "@layerfs/runtime": "link:../layerfs/api/runtime",
    "@lezer/highlight": "1.2.5",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "simple-icons": "16.35.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-vite": "6.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
